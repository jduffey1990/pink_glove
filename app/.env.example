# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# --- Core -----------------------------------------------------------------
ENV=local

# Required in production; local/test fall back to a throwaway value.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Encrypts gate codes and alarm codes at rest (base.fields.EncryptedTextField).
# Required in production. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# WARNING: back this up somewhere other than the app environment. Losing it
# makes every encrypted column permanently unreadable -- there is no recovery.
FIELD_ENCRYPTION_KEY=

# Comma-separated. Must not contain '*' in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -------------------------------------------------------------
# One URL, so any managed Postgres works without a code change.
DATABASE_URL=postgres://pink_glove:pink_glove@db:5432/pink_glove
DB_CONN_MAX_AGE=60

# Host port for the db container; change if 5432 is already taken locally.
POSTGRES_PORT=5432

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Proxies you control in front of the app; decides which X-Forwarded-For entry
# the sign-in throttles believe. 0 locally (trust the socket only).
NUM_PROXIES=0

# --- Frontend / CORS ------------------------------------------------------
# Comma-separated origins allowed to call this API with credentials. Deployed,
# the frontend is served by this process (ADR-027) and this stays EMPTY: with
# no cross-origin caller the session and CSRF cookies are SameSite=Lax. Setting
# an origin loosens them to SameSite=None -- do that only together with
# UI_DIST_DIR= (a frontend hosted elsewhere), never on a hunch.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Where sign-in links point. Deployed: the app's own https origin. Required in
# production, and must be https -- a customer's sign-in token travels in it.
FRONTEND_BASE_URL=http://localhost:3000

# Shared parent domain for session/CSRF cookies, e.g. .pinkglove.com
# Leave blank for local development.
COOKIE_DOMAIN=

# --- Media storage --------------------------------------------------------
# filesystem | s3 | gcs. The image installs the s3 extra; gcs needs
# `pip install ".[gcs]"`. `filesystem` is development only: production refuses
# it, since nothing serves /media/ outside DEBUG and the container's disk is
# lost on every deploy (ADR-027).
MEDIA_BACKEND=filesystem

# The bucket for s3/gcs. `fly storage create` sets BUCKET_NAME instead, which
# is read as a fallback, along with the AWS SDK's own variable names:
# MEDIA_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://fly.storage.tigris.dev   (Tigris/MinIO; omit for AWS)
# AWS_REGION=auto
# AWS_S3_ADDRESSING_STYLE=path                          (virtual for AWS itself)

# Lifetime of a signed media URL, in seconds.
MEDIA_URL_TTL_SECONDS=300

# --- Frontend build -------------------------------------------------------
# Where Vite's output lives; the image puts it at /ui/dist and settings look
# there (and at ../ui/dist from app/) by default. Set EMPTY to not serve the
# frontend from this process -- compose does that in development, where the
# Vite dev server is the frontend. Production refuses to start if the build
# is missing and this was not set empty on purpose.
# UI_DIST_DIR=

# --- Email ----------------------------------------------------------------
# Local uses the console backend regardless of these.
EMAIL_HOST=smtp.sendgrid.net
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=support@example.com

# --- Sessions -------------------------------------------------------------
# Twelve hours: long enough for a full shift, short enough that a forgotten
# session on a shared machine expires the same day.
SESSION_COOKIE_AGE=43200

# --- Ops ------------------------------------------------------------------
LOG_LEVEL=INFO
QUERY_COUNT_DEBUG=false
GUNICORN_WORKERS=4

# Enable only on a bare VPS that isn't already redirecting at the edge.
SECURE_SSL_REDIRECT=false

# HSTS, in seconds. One year, which is what preload lists require. Set to 0
# while first bringing a domain up over TLS -- a wrong HSTS header is cached
# by every visitor's browser and cannot be withdrawn. includeSubDomains and
# preload are on by default and are right for an app on its own subdomain
# (app.example.com); on an apex domain they commit EVERY subdomain to https,
# so turn them off there.
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# --- Stripe Connect (Phase 4b, ADR-024) -----------------------------------
# All optional. With no secret key the product is exactly Phase 4a: no
# "Connect with Stripe" button, no pay link on invoices, and the pay and
# webhook endpoints answer 503. Production refuses to start with a key but
# no webhook secret -- that would take payments the ledger never hears about.
#
# The platform account's secret key (sk_test_... on staging, sk_live_... in
# production). Tenants' accounts are reached through it with stripe_account=.
STRIPE_SECRET_KEY=
# The signing secret of the CONNECT webhook endpoint ("events on connected
# accounts"), whsec_.... Staging and production are different endpoints
# with different secrets. docs/DEPLOY.md has the setup.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Platform fee on each card payment, as a percentage. Ships at 0: revenue is
# the subscription (ADR-024). Turning one on is configuration, not a release.
STRIPE_APPLICATION_FEE_PERCENT=0
