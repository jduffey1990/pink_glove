# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env

# --- Core -----------------------------------------------------------------
ENV=local

# Required in production; local/test fall back to a throwaway value.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Comma-separated. Must not contain '*' in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -------------------------------------------------------------
# One URL, so any managed Postgres works without a code change.
DATABASE_URL=postgres://pink_glove:pink_glove@db:5432/pink_glove
DB_CONN_MAX_AGE=60

# Host port for the db container; change if 5432 is already taken locally.
POSTGRES_PORT=5432

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Frontend / CORS ------------------------------------------------------
# Comma-separated origins allowed to call this API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# Shared parent domain for session/CSRF cookies, e.g. .pinkglove.com
# Leave blank for local development.
COOKIE_DOMAIN=

# --- Media storage --------------------------------------------------------
# filesystem | s3 | gcs. s3/gcs need the matching extra installed:
#   pip install ".[s3]"
MEDIA_BACKEND=filesystem

# --- Email ----------------------------------------------------------------
# Local uses the console backend regardless of these.
EMAIL_HOST=smtp.sendgrid.net
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=support@example.com

# --- Ops ------------------------------------------------------------------
LOG_LEVEL=INFO
QUERY_COUNT_DEBUG=false
GUNICORN_WORKERS=4

# Enable only on a bare VPS that isn't already redirecting at the edge.
SECURE_SSL_REDIRECT=false

# --- Phase 4 (Stripe) -----------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
