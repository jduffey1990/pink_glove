{
  "name": "pink-glove-ui",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:schema": "cd ../app && .venv/bin/python manage.py spectacular --file ../ui/openapi.yaml",
    "api:types": "npm run api:schema && openapi-typescript openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@mdi/font": "7.4.47",
    "axios": "^1.20.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3",
    "vuetify": "^4.0.2"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.4",
    "eslint-config-vuetify": "^4.3.4",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "openapi-typescript": "^7.13.0",
    "sass-embedded": "^1.98.0",
    "typescript": "~5.9.3",
    "unplugin-fonts": "^2.0.0",
    "vite": "^8.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": ">=22"
  }
}
